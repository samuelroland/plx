{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "plx",
    "version": "0.1.0",
    "identifier": "rs.plx.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "PLX",
                "width": 1000,
                "height": 800
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "linux": {
            "rpm": {
                "desktopTemplate": "./ship/plx.desktop"
            },
            "deb": {
                "desktopTemplate": "./ship/plx.desktop"
            }
        },
        "macOS": {
            "signingIdentity": "-"
        },
        "active": true,
        "targets": [
            "rpm",
            "deb",
            "msi",
            "dmg"
        ],
        "icon": [
            "icons/icon.ico",
            "icons/32x32.png",
            "icons/128x128.png"
        ]
    }
}
